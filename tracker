# Type aliases
Landmark = Any
HandLandmarks = List[Landmark]
Frame = np.ndarray

def safe_distance(a: Landmark, b: Landmark) -> float:
    try:
        if a is None or b is None:
            return 0.0
        return math.sqrt((a.x - b.x) ** 2 + (a.y - b.y) ** 2)
    except (AttributeError, TypeError):
        return 0.0

def safe_angle(a: Landmark, b: Landmark, c: Landmark) -> float:
    try:
        if a is None or b is None or c is None:
            return 0.0

        ba = (a.x - b.x, a.y - b.y)
        bc = (c.x - b.x, c.y - b.y)
        dot = ba[0] * bc[0] + ba[1] * bc[1]
        mag_ba = math.sqrt(ba[0] ** 2 + ba[1] ** 2)
        mag_bc = math.sqrt(bc[0] ** 2 + bc[1] ** 2)

        if mag_ba == 0 or mag_bc == 0:
            return 0.0

        value = dot / (mag_ba * mag_bc)
        value = max(-1.0, min(1.0, value))
        return math.degrees(math.acos(value))
    except (AttributeError, TypeError, ValueError):
        return 0.0

def safe_finger_extended(hand: HandLandmarks, pip: int, dip: int, tip: int) -> bool:
    try:
        if len(hand) <= tip:
            return False
        pip_angle = safe_angle(hand[pip - 1], hand[pip], hand[dip])
        dip_angle = safe_angle(hand[pip], hand[dip], hand[tip])
        return (pip_angle > 155 and dip_angle > 150)
    except (IndexError, TypeError):
        return False

def safe_get_fingers(hand: HandLandmarks) -> Dict[str, bool]:
    return {
        "index": safe_finger_extended(hand, 6, 7, 8),
        "middle": safe_finger_extended(hand, 10, 11, 12),
        "ring": safe_finger_extended(hand, 14, 15, 16),
        "pinky": safe_finger_extended(hand, 18, 19, 20)
    }

def safe_detect_point(hand: HandLandmarks, fingers: Dict[str, bool]) -> int:
    score = 0
    if fingers.get("index", False): score += 40
    if not fingers.get("middle", True): score += 20
    if not fingers.get("ring", True): score += 20
    if not fingers.get("pinky", True): score += 20
    return score

def safe_detect_open(hand: HandLandmarks, fingers: Dict[str, bool]) -> int:
    score = 0
    if fingers.get("index", False): score += 25
    if fingers.get("middle", False): score += 25
    if fingers.get("ring", False): score += 25
    if fingers.get("pinky", False): score += 25
    return score

def safe_detect_fist(hand: HandLandmarks, fingers: Dict[str, bool]) -> int:
    score = 0
    if not fingers.get("index", True): score += 25
    if not fingers.get("middle", True): score += 25
    if not fingers.get("ring", True): score += 25
    if not fingers.get("pinky", True): score += 25
    return score

def safe_detect_pinch(hand: HandLandmarks, fingers: Dict[str, bool]) -> int:
    try:
        if len(hand) <= 9:
            return 0
        hand_scale = safe_distance(hand[0], hand[9])
        if hand_scale == 0: 
            return 0
            
        pinch_distance = safe_distance(hand[4], hand[8]) / hand_scale
        
        if pinch_distance < 0.20: 
            return 100 
        if pinch_distance < 0.30: 
            return 60
        if pinch_distance < 0.40: 
            return 30
            
        return 0
    except (IndexError, ZeroDivisionError):
        return 0

def safe_detect_drag(hand: HandLandmarks, fingers: Dict[str, bool]) -> int:
    try:
        if len(hand) <= 20:
            return 0
        scale = safe_distance(hand[0], hand[9])
        if scale == 0: 
            return 0

        d_index = safe_distance(hand[4], hand[8]) / scale
        d_mid = safe_distance(hand[4], hand[12]) / scale
        d_ring = safe_distance(hand[4], hand[16]) / scale
        d_pinky = safe_distance(hand[4], hand[20]) / scale

        avg_dist = (d_index + d_mid + d_ring + d_pinky) / 4
        max_dist = max(d_index, d_mid, d_ring, d_pinky)

        if avg_dist < 0.25 and max_dist < 0.40: 
            return 110 
        if avg_dist < 0.30 and max_dist < 0.45: 
            return 80
        if avg_dist < 0.35: 
            return 50
        return 0
    except (IndexError, ZeroDivisionError):
        return 0

class SafeSwipeDetector:
    def __init__(self):
        self.positions: deque = deque(maxlen=20)
        self.cooldown_until: float = 0.0

    def update(self, x: float, y: float) -> Optional[str]:
        try:
            now = time.time()
            self.positions.append((x, y, now))

            if now < self.cooldown_until: 
                return None
            if len(self.positions) < 5: 
                return None

            x0, y0, t0 = self.positions[0]
            dx = x - x0
            dy = y - y0
            dt = now - t0

            if dt <= 0 or dt > 0.7:
                if dt > 0.7: 
                    self.positions.popleft()
                return None

            if abs(dx) <= 2 * abs(dy) or abs(dx) < 0.35: 
                return None

            velocity = math.sqrt(dx ** 2 + dy ** 2) / dt
            if velocity < 0.8: 
                return None

            gesture = "SWIPE RIGHT" if dx > 0 else "SWIPE LEFT"
            self.cooldown_until = now + 0.5
            self.positions.clear()
            return gesture
        except Exception:
            return None

class SafeGestureStateMachine:
    def __init__(self):
        self.current: str = "NONE"
        self.candidate: Optional[str] = None
        self.counter: int = 0
        self.required_frames: int = 5

    def update(self, detected: str) -> Tuple[str, List[str]]:
        events: List[str] = []
        try:
            if detected == self.current:
                events.append(f"{self.current}_HOLD")
                return self.current, events

            if detected == self.candidate:
                self.counter += 1
            else:
                self.candidate = detected
                self.counter = 1

            if self.counter >= self.required_frames:
                previous = self.current
                self.current = detected
                self.counter = 0
                self.candidate = None

                if previous != "NONE":
                    events.append(f"{previous}_END")
                events.append(f"{self.current}_START")

        except Exception as e:
            print(f"Erro na máquina de estados: {e}")

        return self.current, events

class SafeDualPinchZoom:
    def __init__(self):
        self.active: bool = False
        self.start_distance: Optional[float] = None

    def start(self, distance_val: float) -> None:
        self.active = True
        self.start_distance = distance_val

    def stop(self) -> None:
        self.active = False
        self.start_distance = None

    def factor(self, current_distance: float) -> float:
        try:
            if not self.active or self.start_distance is None or self.start_distance == 0:
                return 1.0
            return current_distance / self.start_distance
        except ZeroDivisionError:
            return 1.0

# Constantes para desenho
CONNECTIONS = [
    (0, 1), (1, 2), (2, 3), (3, 4),           
    (0, 5), (5, 6), (6, 7), (7, 8),           
    (0, 9), (9, 10), (10, 11), (11, 12),      
    (0, 13), (13, 14), (14, 15), (15, 16),    
    (0, 17), (17, 18), (18, 19), (19, 20),    
    (5, 9), (9, 13), (13, 17)                 
]

def safe_draw_hand(frame: Frame, hand: HandLandmarks, 
                   color: Tuple[int, int, int] = (255, 255, 255), 
                   point_color: Tuple[int, int, int] = (0, 255, 0)) -> None:
    try:
        if frame is None or hand is None or len(hand) == 0:
            return

        height, width = frame.shape[:2]

        for start, end in CONNECTIONS:
            if start < len(hand) and end < len(hand):
                x1, y1 = int(hand[start].x * width), int(hand[start].y * height)
                x2, y2 = int(hand[end].x * width), int(hand[end].y * height)
                cv2.line(frame, (x1, y1), (x2, y2), color, 2)

        for i, point in enumerate(hand):
            x, y = int(point.x * width), int(point.y * height)
            cv2.circle(frame, (x, y), 5, point_color, -1)
    except Exception as e:
        print(f"Erro ao desenhar mão: {e}")

